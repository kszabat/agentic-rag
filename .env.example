# Only Gemini LLM is supported for now
LLM__PROVIDER=gemini
LLM__MODEL_NAME=gemini-3-flash-preview
LLM__API_KEY=

QDRANT__URL=
QDRANT__API_KEY=

# Only BAAI/bge-m3 is supported for now
TEXT_EMBEDDING__MODEL_NAME=BAAI/bge-m3
TEXT_EMBEDDING__DEVICE=cuda
TEXT_EMBEDDING__VECTOR_SIZE=1024

# For image mode, currently not implemented
