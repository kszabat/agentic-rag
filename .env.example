# COLPALI__VECTOR_SIZE=128

RERANKER__MODE=api
RERANKER__API_KEY=

# if RERANKER__MODE is set to "local"
RERANKER__MODEL_NAME=jinaai/jina-reranker-m0
RERANKER__DEVICE=cuda
